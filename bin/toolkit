#!/usr/bin/env node
'use strict';

const fs = require('fs');
const path = require('path');
const os = require('os');
const readline = require('readline');

const manifestLib = require('../lib/manifest');
const source = require('../lib/source');
const scanLib = require('../lib/scan');
const writers = {
  copilot: require('../lib/writers/copilot'),
  claude: require('../lib/writers/claude'),
  gemini: require('../lib/writers/gemini'),
};

const TOOLKIT_ROOT = path.join(__dirname, '..');
const GLOBAL_DIR = path.join(TOOLKIT_ROOT, 'global');
const ALL_TOOLS = Object.keys(writers);
const TOOLKIT_VERSION = fs.readFileSync(path.join(TOOLKIT_ROOT, 'VERSION'), 'utf8').trim();

function printHelp() {
  console.log(`toolkit - install or update the org dev toolkit

Usage:
  bin/toolkit [options]
  bin/toolkit scan [--target=<path>] [--json]

Options:
  --scope=user|workspace   Where to install. user = this PC (~/.copilot, ~/.claude, ~/.gemini),
                           available in every project. workspace = the current project only.
  --target=<path>          Project root for workspace scope (default: current directory).
  --tools=a,b,c            Target CLIs to generate for (default: ${ALL_TOOLS.join(',')}).
  --agents=a,b,c           Agents to install (default: all).
  --skills=a,b,c           Skills to install (default: all).
  --yes, -y                Non-interactive: use flags/defaults, skip prompts.
  --help, -h               Show this help.

Re-running with no flags updates an existing install in place, reusing its
prior selection. Files you've hand-edited locally are detected via checksum
and left untouched (with a warning) rather than being overwritten. If the
org source for that same file also changed upstream, it's reported as a
conflict needing a manual merge rather than a plain preserved edit.

"scan" inspects a repo (stack, test tooling, CI, existing toolkit installs)
without writing anything. It's what the repo-init agent shells out to
instead of re-deriving repo state via ad hoc search each run.`);
}

function printScanHelp() {
  console.log(`toolkit scan - inspect a repo without installing anything

Usage:
  bin/toolkit scan [--target=<path>] [--json]

Options:
  --target=<path>   Repo to scan (default: current directory).
  --json            Print raw JSON instead of a human-readable summary.`);
}

function parseArgs(argv) {
  const args = { tools: null, agents: null, skills: null, scope: null, target: null, yes: false, help: false };
  for (const raw of argv) {
    if (raw === '--help' || raw === '-h') args.help = true;
    else if (raw === '--yes' || raw === '-y') args.yes = true;
    else if (raw.startsWith('--scope=')) args.scope = raw.slice('--scope='.length);
    else if (raw.startsWith('--target=')) args.target = raw.slice('--target='.length);
    else if (raw.startsWith('--tools=')) args.tools = splitList(raw.slice('--tools='.length));
    else if (raw.startsWith('--agents=')) args.agents = splitList(raw.slice('--agents='.length));
    else if (raw.startsWith('--skills=')) args.skills = splitList(raw.slice('--skills='.length));
    else {
      console.error(`Unrecognized argument: ${raw}`);
      process.exit(1);
    }
  }
  return args;
}

function splitList(s) {
  return s.split(',').map((x) => x.trim()).filter(Boolean);
}

async function askDefault(rl, question, def) {
  const answer = (await rl.question(`${question} [${def}]: `)).trim();
  return answer || def;
}

function runScan(argv) {
  let target = process.cwd();
  let json = false;
  for (const raw of argv) {
    if (raw.startsWith('--target=')) target = raw.slice('--target='.length);
    else if (raw === '--json') json = true;
    else if (raw === '--help' || raw === '-h') {
      printScanHelp();
      return;
    } else {
      console.error(`Unrecognized argument: ${raw}`);
      process.exitCode = 1;
      return;
    }
  }

  const root = path.resolve(target);
  const result = scanLib.scan(root);

  if (json) {
    console.log(JSON.stringify(result, null, 2));
    return;
  }

  console.log(`Scan of ${root}\n`);

  if (result.toolkit.manifest) {
    const m = result.toolkit.manifest;
    console.log(`Toolkit already installed: v${m.toolkitVersion} (${m.scope} scope), last updated ${m.updatedAt}`);
    console.log(`  selection: tools=${m.selection.tools.join(',')} agents=${m.selection.agents.join(',')} skills=${m.selection.skills.join(',')}`);
    console.log('  -> this is an update, not a first install. Run "bin/toolkit" directly.\n');
  } else {
    console.log('No .devtoolkit/manifest.json found - this looks like a first install.\n');
  }

  for (const [tool, info] of Object.entries(result.toolkit.installed)) {
    if (info.present) {
      console.log(
        `${tool}: existing files found (agents: ${info.agents.length}, skills: ${info.skills.length}, instructions: ${info.hasInstructions ? 'yes' : 'no'}) - likely in use.`
      );
    }
  }

  console.log(`\nDetected stack(s): ${result.stacks.length ? result.stacks.join(', ') : 'none detected'}`);
  console.log(
    `Test tooling: ${result.testing.hasTestTooling ? 'detected' : 'none detected'}` +
      (result.testing.configSignals.length ? ` (${result.testing.configSignals.join(', ')})` : '') +
      (result.testing.packageTestScript ? ` (package.json test script: "${result.testing.packageTestScript}")` : '')
  );
  console.log(`CI: ${result.ci.present ? `detected (${result.ci.signals.join(', ')})` : 'none detected'}`);
  console.log(`CODEOWNERS: ${result.codeowners ? 'present' : 'not found'}`);
}

// Writes `content` to `filePath`, respecting manifest-recorded checksums so a
// locally hand-edited file is never silently clobbered. Distinguishes a
// harmless local edit (source unchanged upstream) from a real conflict
// (local edit AND the org source moved), so updates never silently drop
// either side.
function writeTracked(filePath, content, sourceHash, manifestFiles, previousManifestFiles, report) {
  const outputHash = manifestLib.sha256(content);
  const prior = previousManifestFiles && previousManifestFiles[filePath];
  const existsOnDisk = fs.existsSync(filePath);

  if (existsOnDisk) {
    const onDisk = fs.readFileSync(filePath, 'utf8');
    const onDiskHash = manifestLib.sha256(onDisk);
    if (prior && onDiskHash !== prior.outputHash) {
      const sourceChanged = prior.sourceHash !== sourceHash;
      report[sourceChanged ? 'conflicts' : 'localEditsPreserved'].push(filePath);
      manifestFiles[filePath] = prior; // keep tracking the last-known-synced state
      return;
    }
    if (!prior) {
      // File exists but the toolkit never wrote it (foreign file) — don't overwrite.
      report.skippedForeign.push(filePath);
      return;
    }
    if (onDiskHash === outputHash) {
      manifestFiles[filePath] = { outputHash, sourceHash };
      return; // already up to date
    }
  }

  fs.mkdirSync(path.dirname(filePath), { recursive: true });
  fs.writeFileSync(filePath, content);
  manifestFiles[filePath] = { outputHash, sourceHash };
  report[existsOnDisk ? 'updated' : 'created'].push(filePath);
}

async function main() {
  const rawArgv = process.argv.slice(2);
  if (rawArgv[0] === 'scan') {
    runScan(rawArgv.slice(1));
    return;
  }

  const args = parseArgs(rawArgv);
  if (args.help) {
    printHelp();
    return;
  }

  const agentsSource = source.loadAgents(GLOBAL_DIR);
  const skillsSource = source.loadSkills(GLOBAL_DIR);
  const instructionsBody = source.loadInstructions(GLOBAL_DIR);

  const interactive = Boolean(process.stdin.isTTY && process.stdout.isTTY) && !args.yes;
  const rl = interactive ? readline.createInterface({ input: process.stdin, output: process.stdout }) : null;

  let scope = args.scope;
  if (!scope && interactive) {
    const answer = await askDefault(
      rl,
      'Install scope? "user" = this PC, available in every project. "workspace" = current project only',
      'workspace'
    );
    scope = answer.toLowerCase().startsWith('u') ? 'user' : 'workspace';
  }
  scope = scope || 'workspace';
  if (scope !== 'user' && scope !== 'workspace') {
    console.error(`Unknown scope "${scope}". Expected "user" or "workspace".`);
    process.exitCode = 1;
    if (rl) rl.close();
    return;
  }

  const root = scope === 'user' ? os.homedir() : path.resolve(args.target || process.cwd());
  const previousManifest = manifestLib.load(root);
  const mode = previousManifest ? 'update' : 'install';

  const defaults = {
    tools: (previousManifest && previousManifest.selection.tools) || ALL_TOOLS,
    agents: (previousManifest && previousManifest.selection.agents) || agentsSource.map((a) => a.id),
    skills: (previousManifest && previousManifest.selection.skills) || skillsSource.map((s) => s.id),
  };

  let tools = args.tools || defaults.tools;
  let agentIds = args.agents || defaults.agents;
  let skillIds = args.skills || defaults.skills;

  if (interactive && mode === 'install' && !args.tools && !args.agents && !args.skills) {
    tools = splitList(await askDefault(rl, `Target CLIs (${ALL_TOOLS.join(',')})`, tools.join(',')));
    agentIds = splitList(
      await askDefault(rl, `Agents (${agentsSource.map((a) => a.id).join(',')})`, agentIds.join(','))
    );
    skillIds = splitList(
      await askDefault(rl, `Skills (${skillsSource.map((s) => s.id).join(',')})`, skillIds.join(','))
    );
  }
  if (rl) rl.close();

  for (const t of tools) {
    if (!writers[t]) {
      console.error(`Unknown tool "${t}". Expected one of: ${ALL_TOOLS.join(', ')}`);
      process.exitCode = 1;
      return;
    }
  }

  const selectedAgents = agentsSource.filter((a) => agentIds.includes(a.id));
  const selectedSkills = skillsSource.filter((s) => skillIds.includes(s.id));

  const report = { created: [], updated: [], conflicts: [], localEditsPreserved: [], skippedForeign: [] };
  const manifestFiles = {};
  const previousFiles = previousManifest ? previousManifest.files : {};
  const instructionsSourceHash = manifestLib.sha256(instructionsBody);

  for (const toolId of tools) {
    const writer = writers[toolId];

    for (const agent of selectedAgents) {
      const filePath = writer.agentPath(root, scope, agent.id);
      writeTracked(filePath, writer.renderAgent(agent), manifestLib.sha256(agent.raw), manifestFiles, previousFiles, report);
    }

    for (const skill of selectedSkills) {
      const filePath = writer.skillPath(root, scope, skill.id);
      writeTracked(filePath, writer.renderSkill(skill), manifestLib.sha256(skill.raw), manifestFiles, previousFiles, report);
    }

    const instrPath = writer.instructionsPath(root, scope);
    writeTracked(instrPath, writer.renderInstructions(instructionsBody), instructionsSourceHash, manifestFiles, previousFiles, report);
  }

  manifestLib.save(root, {
    toolkitVersion: TOOLKIT_VERSION,
    scope,
    installedAt: (previousManifest && previousManifest.installedAt) || new Date().toISOString(),
    updatedAt: new Date().toISOString(),
    selection: { tools, agents: agentIds, skills: skillIds },
    files: manifestFiles,
  });

  console.log(`\n${mode === 'install' ? 'Installed' : 'Updated'} dev_toolkit v${TOOLKIT_VERSION} (${scope} scope) at ${root}`);
  console.log(`  tools:  ${tools.join(', ')}`);
  console.log(`  agents: ${agentIds.join(', ')}`);
  console.log(`  skills: ${skillIds.join(', ')}`);
  console.log(`  created: ${report.created.length}, updated: ${report.updated.length}`);
  if (report.conflicts.length) {
    console.log(`\n${report.conflicts.length} CONFLICT(S) - edited locally AND the org source changed upstream. Manual merge needed:`);
    for (const f of report.conflicts) console.log(`  - ${f}`);
  }
  if (report.localEditsPreserved.length) {
    console.log(`\n${report.localEditsPreserved.length} local edit(s) preserved (org source unchanged, nothing lost):`);
    for (const f of report.localEditsPreserved) console.log(`  - ${f}`);
  }
  if (report.skippedForeign.length) {
    console.log(`\nSkipped ${report.skippedForeign.length} pre-existing file(s) not managed by this toolkit:`);
    for (const f of report.skippedForeign) console.log(`  - ${f}`);
  }
}

main().catch((err) => {
  console.error(err.stack || String(err));
  process.exitCode = 1;
});
